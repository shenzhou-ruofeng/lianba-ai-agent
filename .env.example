# ==== 数据库 ====
# 仅数据库密码为敏感项，用占位符；真实值请写入本地 .env（不会入库）
DB_NAME=yu_ai_agent
DB_USERNAME=shenzhou_ruofeng
DB_PASSWORD=your-db-password

# 说明：后端大模型/解析服务密钥（DashScope、MinerU、MiMo、SearchAPI）
# 已统一配置在 src/main/resources/application-prod.yml（该文件已 gitignore）；
# MCP 图片搜索的 Pexels key 已写在 yu-image-search-mcp-server 的 application.yml。
# 打包时会写进各自的镜像，因此这里无需再注入密钥。

# ==== 可选：MCP 服务地址（compose 内默认走服务名，无需修改）====
# MCP_SERVER1_URL=http://mcp-server:8127
